extends Node3D

@onready var board_square := preload("res://scenes/board_square.tscn");

var squares: Array

func _ready():
	initialize_board()

func initialize_board():
	squares = []
	for rank in range(8):
		squares.append([])
		for file in range(8):
			squares[rank].append(0)

			var bp = board_square.instantiate()
			add_child(bp)
			print(bp.position)

	var back_rank = [4, 2, 3, 5, 6, 3, 2, 4]

	for x in range(8):
		squares[0][x] = -back_rank[x]
		squares[1][x] = -1

	for x in range(8):
		squares[7][x] = back_rank[x]
		squares[6][x] = 1

	print(squares)
